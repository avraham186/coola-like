# Copy this file to .env and fill in the values.

REACT_APP_BASE_URL=http://localhost:3000
REACT_APP_URI=https://your-api-host.example.com

# API
REACT_APP_PROJECT=/api/projects/
REACT_APP_EVENT=/api/events/
REACT_APP_JOB=/api/jobs/
REACT_APP_GET_USER_ME=/api/users/me

# Social login (OAuth client IDs only, never client secrets)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_LINKEDIN_CLIENT_ID=
REACT_APP_FACEBOOK_CLIENT_ID=
